{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "import/extensions": [
      "error",
      "never",
      { "ignorePackages": true, "pattern": { "css": "always", "json": "always" } }
    ]
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    ".turbo/**",
    ".vercel/**",
    ".output/**",
    "coverage/**",
    "outputs/**",
    "**/*.gen.ts",
    "packages/react/load-fixtures/broken.tsx"
  ],
  "overrides": [
    {
      "files": ["packages/preview/src/ui/**/*.{ts,tsx}"],
      "env": {
        "browser": true,
        "node": false
      }
    }
  ]
}
