{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "tooling/**/*.ts",
    "tooling/**/*.tsx",
    "packages/react/load-fixtures/**/*.ts",
    "packages/react/load-fixtures/**/*.tsx",
    "packages/react/golden-fixtures/**/*.ts",
    "packages/react/golden-fixtures/**/*.tsx",
    "vitest.setup.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "packages/preview/src/ui/**",
    "packages/preview/src/ui.browser.test.ts",
    "packages/preview/src/ui.sidebar-toggle.test.ts",
    "packages/preview/vite.config.ts",
    "packages/react/load-fixtures/broken.tsx",
    "tooling/release/**/*.test.ts",
    "vitest.config.ts"
  ]
}
