{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "proof/**/*.ts",
    "proof/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "tooling/**/*.ts",
    "packages/react/load-fixtures/**/*.ts",
    "packages/react/load-fixtures/**/*.tsx",
    "vitest.setup.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "proof/out/**",
    "proof/out-external/**",
    "packages/preview/src/ui/**",
    "packages/preview/src/ui.browser.test.ts",
    "packages/preview/src/ui.sidebar-toggle.test.ts",
    "packages/preview/vite.config.ts",
    "packages/react/load-fixtures/broken.tsx",
    "vitest.config.ts"
  ]
}
